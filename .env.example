# LPO Agent configuration. Copy to .env and fill in. NEVER commit .env (Section 12).

# Provider selection: "fireworks" (default) or "mock" (offline, no key needed).
LPO_PROVIDER=fireworks

# Fireworks AI (Section 8). Required when LPO_PROVIDER=fireworks.
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Model IDs (Section 3.1) — confirm against the live Fireworks catalog.
# LPO_FORMULATION_MODEL=accounts/fireworks/models/gemma-4-31b-it
# LPO_EXPLANATION_MODEL=accounts/fireworks/models/gemma-4-26b-a4b-it

# Inference / pipeline controls.
# LPO_MAX_TOKENS=4096
# LPO_ENABLE_THINKING=true
# LPO_ENABLE_CRITIC=true
# LPO_REQUEST_TIMEOUT=120

# Observability (Section 10): where per-run traces are written.
# LPO_TRACE_DIR=traces
